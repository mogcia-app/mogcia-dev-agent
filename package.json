{
  "name": "mogcia-dev-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop-sdk:build": "tsc -p packages/desktop-sdk/tsconfig.json",
    "cli:build": "tsc -p packages/cli/tsconfig.json",
    "mogcia": "node packages/cli/dist/cli/src/index.js",
    "macos:build": "swift build --package-path \"apps/macos/MOGCIA Desktop\"",
    "desktop-widget:dev": "npm --prefix apps/desktop-widget start",
    "desktop-widget:start": "npm --prefix apps/desktop-widget start",
    "dist:cli": "bash scripts/build-cli-dist.sh",
    "dist:desktop-widget": "bash scripts/build-desktop-widget-macos.sh",
    "dist:tools": "bash scripts/build-release-zips.sh",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "lucide-react": "^1.27.0",
    "next": "^16.2.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "postcss": "$postcss",
    "next": {
      "postcss": "$postcss"
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
