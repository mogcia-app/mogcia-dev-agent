NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Required for server APIs outside Google Cloud runtime.
# In Cloud Run with the proper service account, application default credentials can be used instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Alternative single-value credential for Vercel. Prefer this when multiline keys are hard to save.
FIREBASE_SERVICE_ACCOUNT_BASE64=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_ADVICE_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: generic Cloud Run worker URL for future heavy processing.
CLOUD_RUN_WORKER_URL=
WORKER_SHARED_SECRET=

# Legacy/fallback worker URL for transcription offload.
MOGCIA_TRANSCRIBE_WORKER_URL=

# Optional: task assignment email notifications via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
