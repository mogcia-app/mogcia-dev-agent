rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "TjDadmBAdVYaPEvG3ppfBLS4HGN2";
    }

    function isSelf(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function isTaskParticipant(data) {
      return signedIn() && (data.createdBy == request.auth.uid || data.assigneeId == request.auth.uid);
    }

    function isCalendarParticipant(data) {
      return signedIn() && (
        data.createdBy == request.auth.uid ||
        data.assigneeId == request.auth.uid ||
        (data.attendeeIds is list && request.auth.uid in data.attendeeIds)
      );
    }

    function validTimestampOrNull(value) {
      return value == null || value is timestamp;
    }

    function validTask(data) {
      return data.title is string
        && data.status in ["todo", "in_progress", "waiting", "completed", "cancelled"]
        && data.priority in ["high", "medium", "low"]
        && data.source in ["ai", "manual", "automation"]
        && data.createdBy is string
        && data.assigneeId is string
        && validTimestampOrNull(data.dueDate)
        && validTimestampOrNull(data.completedAt);
    }

    function validCalendarEvent(data) {
      return data.title is string
        && data.eventType in ["meeting", "appointment", "sales", "phone", "visit", "internal", "deskwork", "personal", "other"]
        && data.startAt is timestamp
        && validTimestampOrNull(data.endAt)
        && data.allDay is bool
        && data.createdBy is string
        && data.assigneeId is string
        && data.visibility in ["team", "private"];
    }

    function validWorkspaceRecord(data) {
      return data.name is string
        && data.createdBy is string;
    }

    function validTeleapoRecord(data) {
      return data.userId is string
        && data.salesDomain in ["teleapo", "meeting"]
        && data.customerName is string
        && data.contactName is string
        && data.productName is string
        && data.customerType == "new"
        && data.transcriptionStatus in ["draft", "uploaded", "extracting", "transcribing", "diarizing", "completed", "failed"]
        && data.aiAdviceStatus in ["idle", "running", "completed", "failed"];
    }

    function validKnowledge(data) {
      return data.title is string
        && data.type in ["meeting_note", "sales_talk", "objection", "success_case", "loss_reason", "faq", "industry", "competitor", "operation", "customer_voice", "internal", "other"]
        && data.visibility in ["team", "sales", "admin", "private"]
        && data.status in ["active", "archived"]
        && data.createdBy is string;
    }

    function validAgentRequest(data) {
      return data.userId is string
        && data.rawMessage is string
        && data.status in ["queued", "running", "requires_approval", "completed", "error", "cancelled"]
        && data.source in ["web", "desktop", "cli"];
    }

    function validAgentRun(data) {
      return data.userId is string
        && data.requestId is string
        && data.title is string
        && data.status in ["queued", "running", "requires_approval", "completed", "error", "cancelled"]
        && data.source in ["web", "desktop", "cli"]
        && data.requiresApproval is bool;
    }

    function validAgentNotification(data) {
      return data.userId is string
        && data.title is string
        && data.message is string
        && data.type in ["info", "success", "warning", "error", "approval"]
        && data.read is bool;
    }

    function validDevelopmentProject(data) {
      return data.name is string
        && data.slug is string
        && data.isActive is bool;
    }

    function validDevelopmentWorker(data) {
      return data.name is string
        && data.userId is string
        && data.status in ["online", "offline", "busy", "disabled"]
        && data.capabilities is list;
    }

    function validDevelopmentJob(data) {
      return data.runId is string
        && data.requestId is string
        && data.projectId is string
        && data.userId is string
        && data.title is string
        && data.instruction is string
        && data.status in ["queued", "assigned", "running", "reviewing", "completed", "failed", "cancelled"]
        && data.requiredCapabilities is list;
    }

    function validLead(data) {
      return data.companyName is string
        && data.status in ["new", "contacting", "document_sent", "appointment", "meeting", "considering", "hold", "won", "lost"]
        && data.createdBy is string;
    }

    function validActivity(data) {
      return data.type in ["call", "email", "document", "meeting", "telemarketing", "note", "status_change", "other"]
        && data.createdBy is string
        && data.occurredAt is timestamp;
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validTask(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || request.resource.data.assigneeId == request.auth.uid);
      allow update: if signedIn()
        && validTask(request.resource.data)
        && (isAdmin() || isTaskParticipant(resource.data))
        && (isAdmin() || request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }

    match /calendarEvents/{eventId} {
      allow read: if signedIn()
        && (resource.data.visibility == "team" || resource.data.visibility == null || isAdmin() || isCalendarParticipant(resource.data));
      allow create: if signedIn()
        && validCalendarEvent(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (isAdmin() || request.resource.data.assigneeId == request.auth.uid);
      allow update: if signedIn()
        && validCalendarEvent(request.resource.data)
        && (isAdmin() || isCalendarParticipant(resource.data))
        && (isAdmin() || request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validWorkspaceRecord(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        || (signedIn() && resource.data.createdBy == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["favoriteUserIds", "updatedAt"]));
      allow delete: if isAdmin();

      match /activityLogs/{logId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.companyId == companyId
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
        allow delete: if isAdmin();
      }

      match /files/{fileId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
        allow delete: if isAdmin();
      }

      match /memos/{memoId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    match /{path=**}/activityLogs/{logId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validWorkspaceRecord(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && (request.resource.data.name is string || request.resource.data.title is string)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isAdmin();

      match /changeLogs/{logId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if false;
      }

      match /memos/{memoId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    match /teleapoRecords/{recordId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validTeleapoRecord(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && validTeleapoRecord(request.resource.data)
        && (isAdmin() || resource.data.userId == request.auth.uid)
        && (isAdmin() || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /knowledge/{knowledgeId} {
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.visibility in ["team", "sales"]
          || resource.data.createdBy == request.auth.uid
        );
      allow create: if signedIn()
        && validKnowledge(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && validKnowledge(request.resource.data)
        && (
          isAdmin()
          || resource.data.createdBy == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["favoriteUserIds", "viewCount", "updatedAt"])
        );
      allow delete: if isAdmin();
    }

    match /knowledgeViews/{viewId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /agentRequests/{requestId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && validAgentRequest(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && validAgentRequest(request.resource.data)
        && (isAdmin() || resource.data.userId == request.auth.uid)
        && (isAdmin() || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /agentRuns/{runId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && validAgentRun(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && validAgentRun(request.resource.data)
        && (isAdmin() || resource.data.userId == request.auth.uid)
        && (isAdmin() || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /agentNotifications/{notificationId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && validAgentNotification(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && validAgentNotification(request.resource.data)
        && (isAdmin() || resource.data.userId == request.auth.uid)
        && (isAdmin() || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /developmentProjects/{projectId} {
      allow read: if signedIn();
      allow create: if signedIn() && validDevelopmentProject(request.resource.data);
      allow update: if signedIn() && validDevelopmentProject(request.resource.data);
      allow delete: if isAdmin();

      match /memory/{memoryId} {
        allow read: if signedIn();
        allow create, update: if signedIn();
        allow delete: if isAdmin();
      }
    }

    match /developmentWorkers/{workerId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && validDevelopmentWorker(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && validDevelopmentWorker(request.resource.data)
        && (isAdmin() || resource.data.userId == request.auth.uid)
        && (isAdmin() || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /developmentJobs/{jobId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && validDevelopmentJob(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && validDevelopmentJob(request.resource.data)
        && (isAdmin() || resource.data.userId == request.auth.uid)
        && (isAdmin() || request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();

      match /logs/{logId} {
        allow read: if signedIn() && (isAdmin() || get(/databases/$(database)/documents/developmentJobs/$(jobId)).data.userId == request.auth.uid);
        allow create: if signedIn() && request.resource.data.workerId is string;
        allow update, delete: if isAdmin();
      }
    }

    match /leads/{leadId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validLead(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && validLead(request.resource.data)
        && (isAdmin() || resource.data.createdBy == request.auth.uid || resource.data.assignedUserId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /activities/{activityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validActivity(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn()
        && validActivity(request.resource.data)
        && (isAdmin() || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /users/{userId}/favoriteKnowledge/{knowledgeId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
