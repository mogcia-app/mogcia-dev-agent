rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == "TjDadmBAdVYaPEvG3ppfBLS4HGN2";
    }

    match /teleapoRecords/{userId}/{recordId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if signedIn()
        && (request.auth.uid == userId || isAdmin())
        && request.resource.size < 500 * 1024 * 1024
        && request.resource.contentType.matches('video/mp4|audio/.*');
    }

    match /products/{productId}/resources/{fileName} {
      allow read: if signedIn();
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|application/vnd.*|image/.*');
    }

    match /companies/{companyId}/files/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.resource.size < 100 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
